---
import { t, tm } from "@marc/i18n/content";
import Base from "../layouts/Base.astro";
import { PAGE, slugOf } from "../lib/i18n.ts";

export interface Props { lang: string; kind: "impressum" | "privacy" }
const { lang, kind } = Astro.props;
const title = t(PAGE, `${kind}_title`, lang);
---
<Base lang={lang} title={`${title} · ${t(PAGE, "meta_title", lang)}`} description={t(PAGE, "meta_description", lang)} path={`${kind}/`}>
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 class="m-0 mb-8 font-serif text-5xl font-normal leading-none tracking-[-0.02em]">{title}</h1>
    <div class="prose-paper" set:html={tm(PAGE, `${kind}_body`, lang)} />
    <p><a href={`/${slugOf(lang)}/`} class="inline-flex min-h-11 items-center">{t(PAGE, "back_home", lang)}</a></p>
  </article>
</Base>
