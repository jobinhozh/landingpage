---
import { getCollection } from "astro:content";
import { t, ti, setting } from "@marc/i18n/content";
import Base from "../../layouts/Base.astro";
import CalEmbed from "../../components/CalEmbed.astro";
import PhotoPuzzle from "@marc/ui/PhotoPuzzle.astro";
import { certMeta, certifications } from "../../lib/certifications.ts";
import { PAGE, langPaths, slugOf } from "../../lib/i18n.ts";

export const getStaticPaths = langPaths;
const { code: lang } = Astro.props as { code: string };
const work = await getCollection("work");
const expertise = ["s4", "alm", "crm", "ai"];
const p = (key: string) => t(PAGE, key, lang);
// Profile picture: drop one file into src/assets/ (profile.jpg, .jpeg, .png or .webp). Without one the hero has no picture.
const photo = Object.values(
  import.meta.glob<string>("../../assets/profile.{jpg,jpeg,png,webp}", { eager: true, query: "?url", import: "default" }),
)[0];
const puzzle = (k: string) => t("common", `puzzle_${k}`, lang);
const puzzleLabels = { open: puzzle("open"), hint: puzzle("hint"), solved: puzzle("solved"), shuffle: puzzle("shuffle"), close: puzzle("close"), tile: puzzle("tile") };
---
<Base lang={lang} title={p("meta_title")} description={p("meta_description")} path="">
  <section class="mx-auto max-w-5xl px-6 pb-10 pt-12 sm:pb-20 sm:pt-24">
    {photo && (
      <div class="hero-photo mb-6">
        <PhotoPuzzle src={photo} alt={p("photo_alt")} size={96} class="block size-24 rounded-full border-2 border-line-strong object-cover" labels={puzzleLabels} />
      </div>
    )}
    <p class="m-0 font-mono text-[13px] tracking-[0.08em] text-accent uppercase">{p("hero_eyebrow")}</p>
    <h1 class="mt-5 mb-0 max-w-3xl text-[40px] leading-[1.08] font-bold tracking-[-0.02em] sm:text-6xl">{p("hero_title")}</h1>
    <p class="mt-5 mb-0 max-w-2xl text-[17px] leading-relaxed text-soft sm:text-lg" set:html={ti(PAGE, "hero_text", lang)} />
    <div class="flex flex-wrap gap-3 pt-7">
      <a href="#contact" class="inline-flex min-h-12 items-center rounded-lg bg-accent px-6 text-base font-semibold text-ink no-underline hover:text-ink">{p("cta_book")}</a>
      <a href={setting(PAGE, "linkedin_url")} rel="noopener me" class="inline-flex min-h-12 items-center rounded-lg border border-line-strong px-6 text-base font-medium text-text no-underline hover:border-accent hover:text-text">{p("cta_linkedin")}</a>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="expertise">
    <div class="mx-auto max-w-5xl px-6 py-10 sm:py-16">
      <h2 id="expertise" class="m-0 text-[22px] font-semibold sm:text-3xl">{p("expertise_title")}</h2>
      <ul class="mt-5 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-4 sm:gap-4">
        {expertise.map((id, i) => (
          <li class="flex flex-col gap-2 rounded-[10px] border border-line bg-panel p-4">
            <span class="font-mono text-xs text-accent" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="m-0 text-base font-semibold">{p(`exp_${id}_title`)}</h3>
            <p class="m-0 text-sm leading-snug text-muted" set:html={ti(PAGE, `exp_${id}_text`, lang)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {certifications.length > 0 && (
    <section class="border-t border-line" aria-labelledby="certs">
      <div class="mx-auto max-w-5xl px-6 py-10 sm:py-16">
        <h2 id="certs" class="m-0 text-[22px] font-semibold sm:text-3xl">{p("certs_title")}</h2>
        <ul class="mt-5 grid list-none gap-3 p-0 sm:grid-cols-2 sm:gap-4">
          {certifications.map((c) => {
            const inner = (
              <>
                <span class="font-semibold">{c.name}</span>
                <span class="font-mono text-xs text-muted">{certMeta(c)}</span>
              </>
            );
            return (
              <li>
                {c.url ? (
                  <a href={c.url} rel="noopener" class="flex min-h-11 h-full flex-col gap-1 rounded-[10px] border border-line px-4 py-3 text-text no-underline hover:border-accent hover:text-text">{inner}</a>
                ) : (
                  <div class="flex h-full flex-col gap-1 rounded-[10px] border border-line px-4 py-3">{inner}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="border-t border-line" aria-labelledby="work">
    <div class="mx-auto max-w-5xl px-6 py-10 sm:py-16">
      <h2 id="work" class="m-0 text-[22px] font-semibold sm:text-3xl">{p("work_title")}</h2>
      <ul class="mt-5 grid list-none gap-4 p-0 sm:grid-cols-2">
        {work.map(({ data }) => {
          const inner = (
            <>
              <span class="font-mono text-xs text-muted">{data.industry} · {data.year}</span>
              <h3 class="m-0 text-[17px] font-semibold">{p(`work_${data.id}_title`)}</h3>
              <p class="m-0 text-sm leading-snug text-muted" set:html={ti(PAGE, `work_${data.id}_text`, lang)} />
            </>
          );
          return (
            <li>
              {data.url ? (
                <a href={data.url} rel="noopener" class="flex h-full flex-col gap-1.5 rounded-[10px] border border-line p-[18px] text-text no-underline hover:border-accent hover:text-text">{inner}</a>
              ) : (
                <div class="flex h-full flex-col gap-1.5 rounded-[10px] border border-line p-[18px]">{inner}</div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="contact" class="border-t border-line" aria-labelledby="contact-title">
    <div class="mx-auto max-w-5xl px-6 py-10 sm:py-16">
      <h2 id="contact-title" class="m-0 text-[22px] font-semibold sm:text-3xl">{p("contact_title")}</h2>
      <p class="mt-3 mb-5 text-[15px] leading-normal text-muted" set:html={ti(PAGE, "contact_text", lang)} />
      <CalEmbed calLink={setting(PAGE, "cal_link")} label={p("contact_cta")} />
      <p class="mt-5 mb-0"><a href={`/${slugOf(lang)}/cv.pdf`} class="inline-flex min-h-11 items-center font-mono text-sm">{p("cv_link")}</a></p>
    </div>
  </section>
</Base>
<style>
  .hero-photo { --puzzle-surface: #152130; --puzzle-text: #E6ECF2; --puzzle-accent: #5FD4C3; --puzzle-accent-text: #0E1620; }
</style>
