---
import "../styles/global.css";
import { themeCss } from "../../../../themes.ts";

export interface Props {
  lang: string;
  title: string;
  variant: "calm" | "comic";
  theme?: string;
  slug: string;
}
const { lang, title, variant, theme, slug } = Astro.props;
const fonts =
  variant === "comic"
    ? "https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&display=swap"
    : "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap";
const themeColor = variant === "comic" ? "#111111" : "#EEF1EF";
---
<!doctype html>
<html lang={lang} data-theme={variant === "comic" ? theme : undefined} class={`v-${variant}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href={`/${slug}/manifest.webmanifest`} crossorigin="use-credentials" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={title} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    {variant === "comic" && <style is:inline set:html={themeCss()} />}
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  .v-calm body { background: #EEF1EF; color: #16222B; font-family: "Bricolage Grotesque", system-ui, sans-serif; --accent: #C2410C; }
  .v-calm a { color: #C2410C; }
  .v-comic body {
    color: #111111;
    font-family: "Comic Neue", "Comic Sans MS", cursive;
    background-color: var(--c-bg);
    background-image: radial-gradient(var(--c-dot) 1.7px, transparent 2px);
    background-size: 12px 12px;
  }
  .v-comic a { color: #111111; }

  /* Country look (kid pages): flag ribbon on top, mini flag next to the name, flag strip on the form. */
  .flag-ribbon { height: 14px; background: var(--flag-ribbon) center / cover; border-bottom: 3px solid #111; }
  .flag-mini { display: inline-flex; flex: 0 0 auto; border: 3px solid #111; box-shadow: 3px 3px 0 #111; transform: rotate(6deg); line-height: 0; }
  .v-comic .kid__panel { border-top-width: 0; padding-top: 0; }
  .v-comic .kid__panel::before { content: ""; display: block; height: 10px; margin: 0 -14px 12px; background: var(--flag-ribbon) center / cover; border-top: 3px solid #111; border-bottom: 3px solid #111; }
</style>
