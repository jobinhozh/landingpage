---
import ContactForm from "@marc/ui/ContactForm.astro";
import PhotoPuzzle from "@marc/ui/PhotoPuzzle.astro";
import { has, t, ti } from "@marc/i18n/content";
import { env } from "cloudflare:workers";
import type { PersonalPage } from "../../../../site.config.ts";
import type { FormState } from "../lib/contact.ts";
import Footer from "./Footer.astro";
import Switcher from "./Switcher.astro";

export interface Props { page: PersonalPage; lang: string; sent: boolean; state?: FormState }
const { page, lang, sent, state } = Astro.props;
const p = (k: string) => t(page.id, k, lang);
// Chips with a `chip_<id>_more` text open a small card on hover (mouse) or tap.
const chips = ["city", "crossfit", "hyrox", "travel", "languages"].map((id) => ({
  id,
  label: p(`chip_${id}`),
  more: has(page.id, `chip_${id}_more`, lang) || has(page.id, `chip_${id}_more`, "en") ? p(`chip_${id}_more`) : null,
}));
const puzzle = (k: string) => t("common", `puzzle_${k}`, lang);
const puzzleLabels = { open: puzzle("open"), hint: puzzle("hint"), solved: puzzle("solved"), shuffle: puzzle("shuffle"), close: puzzle("close"), tile: puzzle("tile") };
const title = p("title");
// One line at any length (CLAUDE.md §9): width next to the photo divided by the title's average glyph width.
const titleSize = `min(34px, calc((min(100vw, 480px) - 118px) / ${(Math.max(title.length, 8) * 0.56).toFixed(2)}))`;
---
<div class="private">
  <div class="private__top"><Switcher page={page} lang={lang} /></div>
  <header class="private__head">
    <div class="private__id">
      <PhotoPuzzle src={`/${page.slug}/photo`} alt={p("photo_alt")} size={64} class="private__photo" labels={puzzleLabels} />
      <h1 style={`font-size: ${titleSize}`}>{title}</h1>
    </div>
    <p class="private__intro" set:html={ti(page.id, "intro", lang)} />
    <ul class="private__chips">
      {chips.map((c) =>
        c.more ? (
          <li class="chip-wrap" data-chip>
            <button type="button" class="chip-btn" popovertarget={`chip-${c.id}`}><span class="chip chip--more">{c.label}</span></button>
            <div id={`chip-${c.id}`} popover class="chip-pop">{c.more}</div>
          </li>
        ) : (
          <li class="chip-wrap"><span class="chip">{c.label}</span></li>
        ),
      )}
    </ul>
  </header>
  <main class="private__card">
    {sent ? (
      <section class="private__sent" role="status">
        <h2>{p("sent_title")}</h2>
        <p>{p("sent_body")}</p>
      </section>
    ) : (
      <ContactForm
        variant="calm"
        title={p("form_title")}
        fields={[
          { name: "name", label: p("form_name"), autocomplete: "name", required: true, half: true },
          { name: "contact", label: p("form_contact"), type: "email-or-phone", autocomplete: "email", required: true, half: true },
          { name: "met_where", label: p("form_where") },
          { name: "message", label: p("form_message"), type: "textarea", rows: 2 },
        ]}
        consentLabel={p("form_consent")}
        submitLabel={p("submit")}
        sendingLabel={p("form_sending")}
        values={state?.values}
        errors={state?.errors}
        formError={state?.formError}
        turnstileSiteKey={env.TURNSTILE_SITE_KEY}
      />
    )}
  </main>
  <Footer page={page} lang={lang} />
</div>
<style>
  .private { max-width: 480px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; gap: 12px; padding-bottom: 12px; box-sizing: border-box; }
  .private__top { padding: 6px 8px 0; }
  .private__head { padding: 0 20px; display: flex; flex-direction: column; gap: 8px; }
  .private__id { display: flex; align-items: center; gap: 14px; --puzzle-surface: #FFF; --puzzle-text: #1F2A33; --puzzle-accent: #C2410C; --puzzle-accent-text: #FFF; }
  .private__id :global(.private__photo) { display: block; flex: 0 0 64px; width: 64px; height: 64px; border-radius: 999px; object-fit: cover; background: #C2410C; }
  .private h1 { margin: 0; line-height: 1; font-weight: 800; letter-spacing: -0.03em; white-space: nowrap; }
  .private__intro { margin: 0; font-size: 16px; line-height: 1.4; color: #3B4954; }
  .private__chips { display: flex; flex-wrap: wrap; gap: 0 6px; margin: -9px 0; padding: 0; list-style: none; }
  .chip-wrap { display: flex; align-items: center; min-height: 44px; }
  .chip { display: inline-block; padding: 5px 10px; background: #FFF; border-radius: 999px; font-size: 13px; font-weight: 600; color: #1F2A33; }
  /* The button is the 44 px touch target, the pill inside keeps the small look. */
  .chip-btn { display: flex; align-items: center; min-height: 44px; padding: 0; border: 0; background: none; font: inherit; cursor: pointer; }
  .chip--more::after { content: "+"; margin-left: 5px; color: #C2410C; font-weight: 800; }
  .chip-btn:hover .chip, .chip-btn:focus-visible .chip { box-shadow: 0 0 0 2px #C2410C; }
  .chip-btn:focus-visible { outline: none; }
  .chip-pop {
    position: fixed; inset: auto; margin: 0; width: max-content; max-width: min(320px, calc(100vw - 32px)); max-height: 50vh; overflow: auto;
    padding: 12px 14px; border: 0; border-radius: 12px; background: #1F2A33; color: #FFF;
    font-size: 14px; line-height: 1.45; box-shadow: 0 12px 32px rgb(0 0 0 / 25%);
  }
  .private__card { margin: 0 12px; padding: 16px; background: #FFF; border-radius: 18px; }
  .private__sent h2 { margin: 0 0 8px; font-size: 24px; font-weight: 800; }
  .private__sent p { margin: 0; font-size: 16px; line-height: 1.45; color: #3B4954; }
  .private :global(.pfooter) { margin-top: auto; }
</style>
<script>
  // Place each card under its chip, and open it on hover for mouse users. Tap and keyboard use the native popover.
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  for (const wrap of document.querySelectorAll<HTMLElement>("[data-chip]")) {
    const btn = wrap.querySelector("button")!;
    const pop = wrap.querySelector<HTMLElement>("[popover]")!;
    pop.addEventListener("beforetoggle", (e) => {
      if ((e as ToggleEvent).newState !== "open") return;
      const r = btn.getBoundingClientRect();
      pop.style.top = `${r.bottom + 4}px`;
      pop.style.left = `${Math.max(16, Math.min(r.left, innerWidth - Math.min(320, innerWidth - 32) - 16))}px`;
    });
    if (!fine) continue;
    let timer = 0;
    wrap.addEventListener("mouseenter", () => {
      clearTimeout(timer);
      if (!pop.matches(":popover-open")) pop.showPopover();
    });
    wrap.addEventListener("mouseleave", () => {
      timer = window.setTimeout(() => pop.matches(":popover-open") && pop.hidePopover(), 200);
    });
  }
</script>
