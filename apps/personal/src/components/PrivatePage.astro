---
import ContactForm from "@marc/ui/ContactForm.astro";
import PhotoPuzzle from "@marc/ui/PhotoPuzzle.astro";
import { t, ti } from "@marc/i18n/content";
import { env } from "cloudflare:workers";
import type { PersonalPage } from "../../../../site.config.ts";
import type { FormState } from "../lib/contact.ts";
import Footer from "./Footer.astro";
import Switcher from "./Switcher.astro";
import sport from "../data/sport.json";
import { worldMap } from "../data/world-map.ts";

export interface Props { page: PersonalPage; lang: string; sent: boolean; state?: FormState }
const { page, lang, sent, state } = Astro.props;
const p = (k: string) => t(page.id, k, lang);
// Small line icons (decorative, 16 px, currentColor).
const icons: Record<string, string> = {
  city: '<path d="M8 14s5-4.6 5-8.5A5 5 0 0 0 3 5.5C3 9.4 8 14 8 14Z"/><circle cx="8" cy="5.6" r="1.8"/>',
  hyrox: '<circle cx="8" cy="9" r="5"/><path d="M8 9V6.5M6.5 2h3M12.2 4.8l1-1"/>',
  travel: '<path d="M14 2 2 7l5 1.5L8.5 14 14 2Z"/>',
};
const icon = (id: string) =>
  `<svg class="chip__icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[id] ?? ""}</svg>`;
// Hidden by default. ?show=travel, ?show=sport or ?show=travel,sport adds the blocks (also on the QR link /s/<token>?show=…).
const shown = new Set((Astro.url.searchParams.get("show") ?? "").split(",").map((h) => h.trim()));
const showTravel = shown.has("travel");
const showSport = shown.has("sport");
// Best results per category (sport.json): a time in "best" or a placing in "rank". Empty shows a dash.
// A rank (CrossFit Open) shows as "#98,372" in the page language's number format.
const results = (sport as { id: string; event: string; year: string; best?: string; rank?: number }[]).map((r) => ({
  ...r,
  label: p(`sport_${r.id}`),
  best: r.rank ? `#${new Intl.NumberFormat(lang === "gsw" ? "de-CH" : lang).format(r.rank)}` : r.best || "–",
}));
const puzzle = (k: string) => t("common", `puzzle_${k}`, lang);
const puzzleLabels = { open: puzzle("open"), hint: puzzle("hint"), solved: puzzle("solved"), shuffle: puzzle("shuffle"), close: puzzle("close"), tile: puzzle("tile") };
const title = p("title");
// One line at any length (CLAUDE.md §9): width next to the photo divided by the title's average glyph width.
const titleSize = `min(34px, calc((min(100vw, 480px) - 118px) / ${(Math.max(title.length, 8) * 0.56).toFixed(2)}))`;
---
<div class="private">
  <div class="private__hero">
  <div class="private__top"><Switcher page={page} lang={lang} /></div>
  <header class="private__head">
    <div class="private__id">
      <PhotoPuzzle src={`/${page.slug}/photo`} alt={p("photo_alt")} size={64} class="private__photo" labels={puzzleLabels} />
      <h1 style={`font-size: ${titleSize}`}>{title}</h1>
    </div>
    <p class="private__intro" set:html={ti(page.id, "intro", lang)} />
    <p class="private__base"><Fragment set:html={icon("city")} />{p("chip_city_more")}</p>
  </header>
  </div>
  <main class="private__card">
    {sent ? (
      <section class="private__sent" role="status">
        <h2>{p("sent_title")}</h2>
        <p>{p("sent_body")}</p>
      </section>
    ) : (
      <ContactForm
        variant="calm"
        title={p("form_title")}
        fields={[
          { name: "name", label: p("form_name"), autocomplete: "name", required: true, half: true },
          { name: "contact", label: p("form_contact"), type: "email-or-phone", autocomplete: "email", required: true, half: true },
          { name: "met_where", label: p("form_where") },
          { name: "message", label: p("form_message"), type: "textarea", rows: 2 },
        ]}
        consentLabel={p("form_consent")}
        submitLabel={p("submit")}
        sendingLabel={p("form_sending")}
        values={state?.values}
        errors={state?.errors}
        formError={state?.formError}
        turnstileSiteKey={env.TURNSTILE_SITE_KEY}
      />
    )}
  </main>
  {(showTravel || showSport) && (
  <section class="file" aria-labelledby="file-title">
    <h2 id="file-title">{p("card_title")}</h2>
    {showTravel && (
    <div class="file__panel">
      <h3><Fragment set:html={icon("travel")} />{p("card_travel_value")}</h3>
      <svg class="map" viewBox={`0 0 ${worldMap.width} ${worldMap.height}`} role="img" aria-label={p("map_label")}>
        <path class="map__land" d={worldMap.land} />
        <path class="map__visited" d={worldMap.visited} />
        {worldMap.pins.map(([x, y]) => <circle class="map__pin" cx={x} cy={y} r="1.9" />)}
      </svg>
      <p class="map__legend"><span class="map__key"></span>{p("map_legend")}</p>
    </div>
    )}
    {showSport && (
    <div class="file__panel">
      <h3><Fragment set:html={icon("hyrox")} />{p("sport_title")}</h3>
      <table class="sport">
        <thead><tr><th scope="col">{p("sport_col_category")}</th><th scope="col">{p("sport_col_event")}</th><th scope="col">{p("sport_col_best")}</th></tr></thead>
        <tbody>
          {results.map((r) => (
            <tr><th scope="row">{r.label}</th><td>{r.event} {r.year}</td><td class="sport__best">{r.best}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    )}
  </section>
  )}
  <Footer page={page} lang={lang} />
</div>
<style>
  /* Graphic novel: ink on warm paper, halftone, one red, a mustard caption box. Comic like the kids' pages, but grown up. */
  .private {
    --ink: #141414; --paper: #F3EEE4; --red: var(--p-accent, #C8102E); --mustard: var(--p-caption, #F2C14E);
    --accent: var(--red);
    max-width: 480px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; gap: 12px; padding-bottom: 12px; box-sizing: border-box;
    color: var(--ink);
    background-color: var(--paper);
    background-image: radial-gradient(rgb(20 20 20 / 9%) 1.1px, transparent 1.4px);
    background-size: 9px 9px;
  }
  .private__hero { display: flex; flex-direction: column; gap: 12px; }
  .private__top { padding: 6px 8px 0; }
  .private__head { padding: 0 16px; display: flex; flex-direction: column; gap: 10px; }
  .private__id { display: flex; align-items: center; gap: 14px; --puzzle-surface: #FFF; --puzzle-text: #141414; --puzzle-accent: var(--red); --puzzle-accent-text: #FFF; }
  .private__id :global(.private__photo) {
    display: block; flex: 0 0 72px; width: 72px; height: 72px; border-radius: 999px; object-fit: cover; background: var(--mustard);
    border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); box-sizing: border-box;
  }
  .private h1 { margin: 0; line-height: 0.95; font-family: "Anton", "Bricolage Grotesque", sans-serif; font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; white-space: nowrap; }
  /* Narration box, as in a comic panel. */
  .private__intro {
    margin: 0; padding: 8px 12px; font-size: 15px; line-height: 1.4; font-weight: 600;
    background: var(--mustard); border: 2.5px solid var(--ink); box-shadow: 3px 3px 0 var(--ink);
  }
  :global(.chip__icon) { flex: none; margin-right: 5px; color: var(--red); }
  .private__card { margin: 0 12px; padding: 16px; background: #FFF; border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .private__card :global(.cform__title) { font-family: "Anton", sans-serif; font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; font-size: 24px; }
  .private .private__card :global(input[type="text"]), .private .private__card :global(textarea) { border: 2px solid var(--ink); border-radius: 6px; }
  .private .private__card :global(.chip span) { border: 2px solid var(--ink); }
  .private__card :global(.cform__submit) { border: 2.5px solid var(--ink); border-radius: 6px; box-shadow: 3px 3px 0 var(--ink); text-transform: uppercase; letter-spacing: 0.03em; }
  .private__sent h2 { margin: 0 0 8px; font-family: "Anton", sans-serif; font-weight: 400; text-transform: uppercase; font-size: 26px; }
  .private__sent p { margin: 0; font-size: 16px; line-height: 1.45; }

  .private__base { display: flex; align-items: center; margin: -2px 0 0; font-size: 14px; font-weight: 700; }

  /* The file: Marc's hero card with the travel map and the sport results. */
  .file { margin: 8px 12px 0; padding: 14px; background: var(--mustard); border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); display: flex; flex-direction: column; gap: 12px; }
  .file h2 { margin: 0; font-family: "Anton", sans-serif; font-weight: 400; font-size: 24px; text-transform: uppercase; letter-spacing: 0.02em; }
  .file__panel { background: #FFF; border: 2.5px solid var(--ink); padding: 10px 12px; }
  .file h3 { display: flex; align-items: center; margin: 0 0 8px; font-family: "Anton", sans-serif; font-weight: 400; font-size: 20px; text-transform: uppercase; letter-spacing: 0.01em; }
  .map { display: block; width: 100%; height: auto; }
  .map__land { fill: none; stroke: #141414; stroke-opacity: 0.32; stroke-width: 1.8; stroke-linecap: round; }
  .map__visited { fill: none; stroke: var(--red); stroke-width: 2.2; stroke-linecap: round; }
  .map__pin { fill: var(--red); stroke: #FFF; stroke-width: 0.6; }
  .map__legend { display: flex; align-items: center; gap: 6px; margin: 6px 0 0; font-size: 12px; font-weight: 700; }
  .map__key { width: 10px; height: 10px; border-radius: 999px; background: var(--red); }
  .sport { width: 100%; border-collapse: collapse; font-size: 14px; }
  .sport th, .sport td { padding: 7px 4px; text-align: left; border-bottom: 2px solid #141414; vertical-align: top; }
  .sport thead th { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border-bottom-width: 3px; }
  .sport tbody tr:last-child th, .sport tbody tr:last-child td { border-bottom: 0; }
  .sport tbody th { font-weight: 800; }
  .sport__best { font-family: "Anton", sans-serif; font-size: 18px; white-space: nowrap; text-align: right !important; }
  .sport thead th:last-child { text-align: right; }
  .private :global(.pfooter) { margin-top: auto; }
  .private :global(.lang-switch--calm a[aria-current="true"]) { background: var(--ink); color: #FFF; }

</style>
