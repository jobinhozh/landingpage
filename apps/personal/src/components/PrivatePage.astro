---
import ContactForm from "@marc/ui/ContactForm.astro";
import PhotoPuzzle from "@marc/ui/PhotoPuzzle.astro";
import { has, t, ti } from "@marc/i18n/content";
import { env } from "cloudflare:workers";
import type { PersonalPage } from "../../../../site.config.ts";
import type { FormState } from "../lib/contact.ts";
import Footer from "./Footer.astro";
import Switcher from "./Switcher.astro";

export interface Props { page: PersonalPage; lang: string; sent: boolean; state?: FormState }
const { page, lang, sent, state } = Astro.props;
const p = (k: string) => t(page.id, k, lang);
// Chips with a `chip_<id>_more` text open a small card on hover (mouse) or tap.
const chips = ["city", "crossfit", "hyrox", "marathon", "travel", "languages"].map((id) => ({
  id,
  label: p(`chip_${id}`),
  more: has(page.id, `chip_${id}_more`, lang) || has(page.id, `chip_${id}_more`, "en") ? p(`chip_${id}_more`) : null,
}));
// Small line icons per chip (decorative, 16 px, currentColor).
const icons: Record<string, string> = {
  city: '<path d="M8 14s5-4.6 5-8.5A5 5 0 0 0 3 5.5C3 9.4 8 14 8 14Z"/><circle cx="8" cy="5.6" r="1.8"/>',
  crossfit: '<path d="M2 6v4M4.5 4.5v7M11.5 4.5v7M14 6v4M4.5 8h7"/>',
  hyrox: '<circle cx="8" cy="9" r="5"/><path d="M8 9V6.5M6.5 2h3M12.2 4.8l1-1"/>',
  marathon: '<path d="M2 11.5h8.5l3.5 1V14H2v-2.5ZM2 11.5 3 6l3 1 1.5-2.5 3 2v5"/>',
  travel: '<path d="M14 2 2 7l5 1.5L8.5 14 14 2Z"/>',
  languages: '<path d="M2.5 3.5h11v7H8l-3 2.5v-2.5H2.5v-7Z"/>',
};
const icon = (id: string) =>
  `<svg class="chip__icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[id] ?? ""}</svg>`;
// "Hero card" below the form, like the kids' pages: the same facts as the chips, as a file.
const facts = [
  { id: "travel", label: p("chip_travel"), value: p("card_travel_value"), big: true },
  { id: "languages", label: p("chip_languages"), value: p("chip_languages_more"), big: false },
  { id: "hyrox", label: p("chip_hyrox"), value: p("chip_hyrox_more"), big: false },
  { id: "crossfit", label: p("chip_crossfit"), value: p("chip_crossfit_more"), big: false },
  { id: "marathon", label: p("chip_marathon"), value: p("chip_marathon_more"), big: false },
  { id: "city", label: p("chip_city"), value: p("chip_city_more"), big: false },
];
const puzzle = (k: string) => t("common", `puzzle_${k}`, lang);
const puzzleLabels = { open: puzzle("open"), hint: puzzle("hint"), solved: puzzle("solved"), shuffle: puzzle("shuffle"), close: puzzle("close"), tile: puzzle("tile") };
const title = p("title");
// One line at any length (CLAUDE.md §9): width next to the photo divided by the title's average glyph width.
const titleSize = `min(34px, calc((min(100vw, 480px) - 118px) / ${(Math.max(title.length, 8) * 0.56).toFixed(2)}))`;
---
<div class="private">
  <div class="private__hero">
  <div class="private__top"><Switcher page={page} lang={lang} /></div>
  <header class="private__head">
    <div class="private__id">
      <PhotoPuzzle src={`/${page.slug}/photo`} alt={p("photo_alt")} size={64} class="private__photo" labels={puzzleLabels} />
      <h1 style={`font-size: ${titleSize}`}>{title}</h1>
    </div>
    <p class="private__intro" set:html={ti(page.id, "intro", lang)} />
    <ul class="private__chips">
      {chips.map((c) =>
        c.more ? (
          <li class="chip-wrap" data-chip>
            <button type="button" class="chip-btn" popovertarget={`chip-${c.id}`}><span class="chip chip--more"><Fragment set:html={icon(c.id)} />{c.label}</span></button>
            <div id={`chip-${c.id}`} popover class="chip-pop">{c.more}</div>
          </li>
        ) : (
          <li class="chip-wrap"><span class="chip"><Fragment set:html={icon(c.id)} />{c.label}</span></li>
        ),
      )}
    </ul>
  </header>
  </div>
  <main class="private__card">
    {sent ? (
      <section class="private__sent" role="status">
        <h2>{p("sent_title")}</h2>
        <p>{p("sent_body")}</p>
      </section>
    ) : (
      <ContactForm
        variant="calm"
        title={p("form_title")}
        fields={[
          { name: "name", label: p("form_name"), autocomplete: "name", required: true, half: true },
          { name: "contact", label: p("form_contact"), type: "email-or-phone", autocomplete: "email", required: true, half: true },
          { name: "met_where", label: p("form_where") },
          { name: "message", label: p("form_message"), type: "textarea", rows: 2 },
        ]}
        consentLabel={p("form_consent")}
        submitLabel={p("submit")}
        sendingLabel={p("form_sending")}
        values={state?.values}
        errors={state?.errors}
        formError={state?.formError}
        turnstileSiteKey={env.TURNSTILE_SITE_KEY}
      />
    )}
  </main>
  <section class="file" aria-labelledby="file-title">
    <h2 id="file-title">{p("card_title")}</h2>
    <dl>
      {facts.map((f) => (
        <div class:list={["file__row", { "file__row--big": f.big }]}>
          <dt><Fragment set:html={icon(f.id)} />{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>
  <Footer page={page} lang={lang} />
</div>
<style>
  /* Graphic novel: ink on warm paper, halftone, one red, a mustard caption box. Comic like the kids' pages, but grown up. */
  .private {
    --ink: #141414; --paper: #F3EEE4; --red: #C8102E; --mustard: #F2C14E;
    --accent: var(--red);
    max-width: 480px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; gap: 12px; padding-bottom: 12px; box-sizing: border-box;
    color: var(--ink);
    background-color: var(--paper);
    background-image: radial-gradient(rgb(20 20 20 / 9%) 1.1px, transparent 1.4px);
    background-size: 9px 9px;
  }
  .private__hero { display: flex; flex-direction: column; gap: 12px; }
  .private__top { padding: 6px 8px 0; }
  .private__head { padding: 0 16px; display: flex; flex-direction: column; gap: 10px; }
  .private__id { display: flex; align-items: center; gap: 14px; --puzzle-surface: #FFF; --puzzle-text: #141414; --puzzle-accent: #C8102E; --puzzle-accent-text: #FFF; }
  .private__id :global(.private__photo) {
    display: block; flex: 0 0 72px; width: 72px; height: 72px; border-radius: 999px; object-fit: cover; background: var(--mustard);
    border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); box-sizing: border-box;
  }
  .private h1 { margin: 0; line-height: 0.95; font-family: "Anton", "Bricolage Grotesque", sans-serif; font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; white-space: nowrap; }
  /* Narration box, as in a comic panel. */
  .private__intro {
    margin: 0; padding: 8px 12px; font-size: 15px; line-height: 1.4; font-weight: 600;
    background: var(--mustard); border: 2.5px solid var(--ink); box-shadow: 3px 3px 0 var(--ink);
  }
  .private__chips { display: flex; flex-wrap: wrap; gap: 0 6px; margin: -6px 0 -9px; padding: 0; list-style: none; }
  .chip-wrap { display: flex; align-items: center; min-height: 44px; }
  .chip {
    display: inline-flex; align-items: center; white-space: nowrap; padding: 4px 9px; font-size: 13px; font-weight: 700;
    background: #FFF; color: var(--ink); border: 2px solid var(--ink); border-radius: 999px; box-shadow: 2px 2px 0 var(--ink);
  }
  :global(.chip__icon) { flex: none; margin-right: 5px; color: var(--red); }
  /* The button is the 44 px touch target, the pill inside keeps the small look. */
  .chip-btn { display: flex; align-items: center; min-height: 44px; padding: 0; border: 0; background: none; font: inherit; cursor: pointer; }
  .chip--more::after { content: "+"; margin-left: 5px; color: var(--red); font-weight: 800; }
  .chip-btn:hover .chip, .chip-btn:focus-visible .chip { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--red); }
  .chip-btn:focus-visible { outline: none; }
  /* Detail card as a speech bubble. */
  .chip-pop {
    position: fixed; inset: auto; margin: 0; width: max-content; max-width: min(320px, calc(100vw - 32px)); max-height: 50vh; overflow: auto;
    padding: 10px 13px; border: 2.5px solid #141414; border-radius: 14px; background: #FFF; color: #141414;
    font-size: 14px; line-height: 1.45; font-weight: 600; box-shadow: 4px 4px 0 #141414;
  }
  .private__card { margin: 0 12px; padding: 16px; background: #FFF; border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .private__card :global(.cform__title) { font-family: "Anton", sans-serif; font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; font-size: 24px; }
  .private .private__card :global(input[type="text"]), .private .private__card :global(textarea) { border: 2px solid var(--ink); border-radius: 6px; }
  .private .private__card :global(.chip span) { border: 2px solid var(--ink); }
  .private__card :global(.cform__submit) { border: 2.5px solid var(--ink); border-radius: 6px; box-shadow: 3px 3px 0 var(--ink); text-transform: uppercase; letter-spacing: 0.03em; }
  .private__sent h2 { margin: 0 0 8px; font-family: "Anton", sans-serif; font-weight: 400; text-transform: uppercase; font-size: 26px; }
  .private__sent p { margin: 0; font-size: 16px; line-height: 1.45; }

  /* The file: Marc's hero card. */
  .file { margin: 8px 12px 0; padding: 14px; background: var(--mustard); border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .file h2 { margin: 0 0 10px; font-family: "Anton", sans-serif; font-weight: 400; font-size: 24px; text-transform: uppercase; letter-spacing: 0.02em; }
  .file dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0; }
  .file__row { background: #FFF; border: 2.5px solid var(--ink); padding: 8px 10px; }
  .file__row--big, .file__row:last-child:nth-child(even) { grid-column: 1 / -1; }
  .file dt { display: flex; align-items: center; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
  .file dd { margin: 3px 0 0; font-size: 14px; line-height: 1.35; font-weight: 600; }
  .file__row--big dd { font-family: "Anton", sans-serif; font-weight: 400; font-size: 30px; line-height: 1; text-transform: uppercase; }
  .private :global(.pfooter) { margin-top: auto; }
  .private :global(.lang-switch--calm a[aria-current="true"]) { background: var(--ink); color: #FFF; }

  @media (prefers-reduced-motion: reduce) { .chip-btn:hover .chip { transform: none; } }
</style>
<script>
  // Place each card under its chip, and open it on hover for mouse users. Tap and keyboard use the native popover.
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  for (const wrap of document.querySelectorAll<HTMLElement>("[data-chip]")) {
    const btn = wrap.querySelector("button")!;
    const pop = wrap.querySelector<HTMLElement>("[popover]")!;
    pop.addEventListener("beforetoggle", (e) => {
      if ((e as ToggleEvent).newState !== "open") return;
      const r = btn.getBoundingClientRect();
      pop.style.top = `${r.bottom + 4}px`;
      pop.style.left = `${Math.max(16, Math.min(r.left, innerWidth - Math.min(320, innerWidth - 32) - 16))}px`;
    });
    if (!fine) continue;
    let timer = 0;
    wrap.addEventListener("mouseenter", () => {
      clearTimeout(timer);
      if (!pop.matches(":popover-open")) pop.showPopover();
    });
    wrap.addEventListener("mouseleave", () => {
      timer = window.setTimeout(() => pop.matches(":popover-open") && pop.hidePopover(), 200);
    });
  }
</script>
