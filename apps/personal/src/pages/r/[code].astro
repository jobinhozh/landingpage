---
/** RSVP for a broadcast. GET shows two buttons, POST records the answer (mail scanners only GET). */
import { env } from "cloudflare:workers";
import { languageByCode } from "@marc/i18n";
import { t } from "@marc/i18n/content";
import { parseRsvpCode, recordRsvp, rsvpTarget } from "../../lib/crm/index.ts";
import { notFound } from "../../lib/http.ts";

const parsed = await parseRsvpCode(env.COOKIE_SIGNING_KEY, Astro.params.code ?? "");
if (!parsed) return notFound();
const target = await rsvpTarget(env.DB, parsed.interactionId, parsed.adultId);
if (!target) return notFound();
const lang = languageByCode(target.language)?.code ?? "en";

let done = false;
if (Astro.request.method === "POST") {
  await recordRsvp(env.DB, target, (await Astro.request.formData()).get("answer") === "yes");
  done = true;
}
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{target.subject}</title>
  </head>
  <body>
    <main>
      <h1>{target.subject}</h1>
      {done ? (
        <p>{t("common", "rsvp_thanks", lang)}</p>
      ) : (
        <form method="post">
          <button name="answer" value="yes" class="yes">{t("common", "rsvp_yes", lang)}</button>
          <button name="answer" value="no" class="no">{t("common", "rsvp_no", lang)}</button>
        </form>
      )}
    </main>
  </body>
</html>
<style is:global>
  body { margin: 0; min-height: 100dvh; display: grid; place-items: center; background: #EEF1EF; color: #16222B; font: 18px/1.4 system-ui, sans-serif; }
  main { padding: 24px; max-width: 420px; text-align: center; }
  h1 { font-size: 24px; }
  form { display: flex; flex-direction: column; gap: 12px; }
  button { min-height: 52px; font: inherit; border-radius: 12px; cursor: pointer; }
  button.yes { font-weight: 700; border: 0; background: #0F766E; color: #FFF; }
  button.no { border: 1.5px solid #C9D1D6; background: #FFF; color: #16222B; }
  button:focus-visible { outline: 3px solid #16222B; outline-offset: 2px; }
</style>
